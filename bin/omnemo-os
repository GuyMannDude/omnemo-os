#!/usr/bin/env bash
# omnemo-os — install / uninstall / status for the Omnemo OS edition layer.
# v0.9 (2026-10-30) written from MANIFEST.md; three cold runs on a stock Omarchy
# 4.5.0rc2 laptop 2026-10-30: install, clicks, uninstall, byte-diff all PASS.
# Contract: user-level only, no sudo, no stock file edits. install backs up every
# file it will change; uninstall restores them byte-for-byte and removes only
# what install created.
set -euo pipefail

VERSION="0.9.2"
# Follow the ~/.local/bin/omnemo-os link back to the installed copy.
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PLUGIN_SRC="$REPO_DIR/plugins"
LAYOUT_JSON="$REPO_DIR/layout.json"

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}"
SHELL_JSON="$CFG/omarchy/shell.json"
PLUGIN_DST="$CFG/omarchy/plugins"
WS_DIR="$STATE/omarchy/workspace-layouts"
HYPR_LUA="$CFG/hypr/hyprland.lua"
BIND_LUA="$CFG/hypr/bindings.lua"
LOOK_LUA="$CFG/hypr/looknfeel.lua"
MENU_JSONC="$CFG/omarchy/extensions/omarchy-menu.jsonc"
SHELL_TOML="$CFG/omarchy/shell.toml"   # machine-level shell colours; wins over the theme
MENU_SEED="/usr/share/omarchy/config/omarchy/extensions/omarchy-menu.jsonc"
OUR_STATE="$STATE/omnemo-os"
RECORD="$OUR_STATE/installed.json"

# Edition plugins (MANIFEST §1). omnemo.memory ships with Omnemo itself, not here.
PLUGINS=(guy.taskbar guy.tools guy.help guy.favorites guy.clock guy.utils guy.flag)   # guy.start retired 10-27
MIN_VERSION="4.5.0"

die()  { printf 'omnemo-os: %s\n' "$*" >&2; exit 1; }
say()  { printf 'omnemo-os: %s\n' "$*"; }
# Move a temp file over a target, keeping the target's mode (mktemp makes 600;
# stock user files are 644). A new file gets 644.
put() { if [[ -e $2 ]]; then chmod --reference="$2" "$1"; else chmod 644 "$1"; fi; mv "$1" "$2"; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }

# --- version gate -----------------------------------------------------------
# Source of truth = the package (tested on the test laptop):
#   pacman -Q omarchy      -> "omarchy 4.5.0rc2-1"   (stable box: "omarchy 4.5.0-1")
#   vercmp "$v" 4.5.0-1    -> -1 for 4.5.0rc2-1, >=0 for 4.5.0-1 and later
# TRAP: /usr/share/omarchy/version holds a stale "4.0.0.alpha"; never gate on it.
# `omarchy version` may print "dev (<hash>)" on git checkouts; display only.
MIN_PKGVER="4.5.0-1"
omarchy_pkgver() { pacman -Q omarchy 2>/dev/null | awk '{print $2}'; }
omarchy_version() { omarchy version 2>/dev/null || omarchy_pkgver; }

check_version() {
  local allow_rc="$1" v
  need pacman; need vercmp
  v="$(omarchy_pkgver)"; [[ -n "$v" ]] || die "omarchy package not installed (pacman -Q omarchy)"
  if (( $(vercmp "$v" "$MIN_PKGVER") >= 0 )); then say "Omarchy $v OK (stable >= 4.5)"; return; fi
  # Below 4.5.0-1: either a 4.5 pre-release (rc/beta/alpha of 4.5) or an older release.
  if [[ "$v" == 4.5.0[a-z]* ]]; then
    [[ "$allow_rc" == 1 ]] || die "Omarchy $v is a pre-release; the edition is gated on 4.5 stable (use --allow-rc to test)"
    say "Omarchy $v OK (pre-release, --allow-rc)"; return
  fi
  die "Omarchy $v is below $MIN_PKGVER"
}

# --- Hyprland windowrule ------------------------------------------------------
# New floating windows open centered and never larger than the screen above the
# bar, so titlebar buttons stay reachable. max_size takes NUMBERS only, so it is
# computed here from the focused monitor and written into the USER file
# ~/.config/hypr/hyprland.lua as a marked block. Formula:
#   max_w = width/scale - 2*gaps_out
#   max_h = height/scale - reserved_bottom - 2*gaps_out - 2*border_size - 14 (titlebar headroom)
RULE_BEGIN="-- omnemo-os:begin (managed; removed by omnemo-os uninstall)"
RULE_END="-- omnemo-os:end"

windowrule_block() {
  need hyprctl
  local mon w h scale rb gaps border maxw maxh
  mon="$(hyprctl monitors -j | jq -c '[.[] | select(.focused==true)][0] // .[0]')"
  [[ -n "$mon" && "$mon" != "null" ]] || die "hyprctl monitors returned no monitor"
  w="$(jq -r .width <<<"$mon")"; h="$(jq -r .height <<<"$mon")"; scale="$(jq -r '.scale // 1' <<<"$mon")"
  # The bar's height is whichever edge it reserves (a stock box still has it on
  # top when this runs, before the bar moves to the bottom).
  rb="$(jq -r '[.reserved[]?] | max // 0' <<<"$mon")"
  gaps="$(hyprctl getoption general:gaps_out -j | jq -r '.custom // "10"' | awk '{print $1}')"
  border="$(hyprctl getoption general:border_size -j | jq -r '.int // 2')"
  maxw="$(awk -v w="$w" -v s="$scale" -v g="$gaps" 'BEGIN{printf "%d", w/s - 2*g}')"
  maxh="$(awk -v h="$h" -v s="$scale" -v rb="$rb" -v g="$gaps" -v b="$border" 'BEGIN{printf "%d", h/s - rb - 2*g - 2*b - 14}')"
  (( maxw > 200 && maxh > 200 )) || die "computed max_size ${maxw}x${maxh} looks wrong; refusing"
  printf '%s\n' "$RULE_BEGIN" \
    "-- Omnemo OS: a new floating window opens centered and never bigger than the" \
    "-- screen above the bottom bar, so its titlebar buttons are always reachable." \
    "-- Computed at install for ${w}x${h}@${scale} (gaps ${gaps}, border ${border}, bar ${rb})." \
    "o.window({ float = true }, { center = true, max_size = { ${maxw}, ${maxh} } })" \
    "$RULE_END"
}

windowrule_remove() {   # strip exactly our block from "$1" (in place)
  local tmp; tmp="$(mktemp)"
  awk -v b="$RULE_BEGIN" -v e="$RULE_END" '$0==b{skip=1} !skip{print} $0==e{skip=0}' "$1" >"$tmp" && put "$tmp" "$1"
}

# --- three more user files (MANIFEST §2 rows: Apps menu, Apps shortcut, cursor) --
# Each is a stock-seeded USER file; we append one marked block and uninstall
# restores the install-time backup byte-exact (or strips the block / removes the
# file if it was absent). The dock is off, and the app grid lived in the dock,
# so "Apps" is re-homed in the menu (all five fields are required or the page
# comes up empty), Super+Alt+Space points at it, and the pointer stops jumping
# to the window centre on a taskbar switch.
bindings_block() {
  printf '%s\n' "$RULE_BEGIN" \
    'hl.unbind("SUPER + ALT + SPACE")' \
    'o.bind("SUPER + ALT + SPACE", "Apps", "omarchy-menu toggle apps")' \
    "$RULE_END"
}
looknfeel_block() {
  printf '%s\n' "$RULE_BEGIN" \
    'hl.config({ cursor = { no_warps = true } })' \
    "$RULE_END"
}
MENU_BEGIN="// omnemo-os:begin (managed; removed by omnemo-os uninstall)"
MENU_END="// omnemo-os:end"
menu_block() {
  printf '%s\n' "  $MENU_BEGIN" \
    '  // The stock dock (switched off) held the app grid; "Apps" lives here instead.' \
    '  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps","action":""},' \
    "  $MENU_END"
}
# Insert our block just before the file's final closing brace (JSONC: one
# top-level object, // comments, trailing commas allowed).
menu_insert() {   # "$1" = file (in place)
  local tmp; tmp="$(mktemp)"
  awk -v blk="$(menu_block)" '
    { L[NR]=$0 }
    END {
      last=0; for (i=NR; i>=1; i--) if (L[i] ~ /^[[:space:]]*}[[:space:]]*$/) { last=i; break }
      if (!last) exit 3
      for (i=1; i<=NR; i++) { if (i==last) print blk; print L[i] }
    }' "$1" >"$tmp" || { rm -f "$tmp"; die "$1 has no closing brace; refusing"; }
  put "$tmp" "$1"
}
menu_remove() {   # strip exactly our block from "$1" (in place)
  local tmp; tmp="$(mktemp)"
  awk -v b="  $MENU_BEGIN" -v e="  $MENU_END" '$0==b{skip=1} !skip{print} $0==e{skip=0}' "$1" >"$tmp" && put "$tmp" "$1"
}

# The shell rebuilds the bar after some of these commands and can miss the
# next call for a few seconds ("omarchy-shell is not responding"). Wait until
# it answers, and try each step twice; every step is safe to repeat.
wait_shell() {
  local i
  for (( i = 0; i < 150; i++ )); do
    omarchy-shell shell ping >/dev/null 2>&1 && return 0
    sleep 0.2
  done
}
shell_step() {
  # The first try runs quietly: a busy shell prints "omarchy-shell is not
  # responding", which alarms people for nothing when the retry then works.
  wait_shell
  "$@" 2>/dev/null && return 0
  sleep 2
  wait_shell
  "$@" && return 0
  die "'$*' failed twice; run 'omnemo-os uninstall' to undo what was applied"
}

# --- everyday-user extras -----------------------------------------------------
# Plain files the edition adds or changes for people who are not developers:
# the one-bar guard, friendly app names, icon sets two stock themes ask for but
# do not ship, and text files opening in Writer. Each path is backed up at
# install (or noted as absent) and put back exactly at uninstall.
SYSTEM_SRC="$REPO_DIR/system"
APPS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICONS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons"
UNITS_DIR="$CFG/systemd/user"
GUARD="$HOME/.local/bin/omnemo-one-bar"
ICON_UPDATER="$HOME/.local/bin/omnemo-icons-update"
MIMEAPPS="$CFG/mimeapps.list"
NAME_MARK="# omnemo-os: friendly name (omnemo-os repair puts it back)"
# Omarchy's white and vantablack themes name these icon sets; neither is
# installed, so app icons vanish in those themes. (upstream report pending)
ICON_SHIMS=(Yaru-gray Yaru-grey)
# desktop id | friendly name | plain description
FRIENDLY_NAMES=(
  "foot|Terminal|Type commands to your computer"
  "omacalc|Calculator|Add, subtract and more"
  "omawrite|Writer|Write notes and documents"
)

managed_files() {
  printf '%s\n' "$GUARD" "$UNITS_DIR/omnemo-one-bar.service" "$UNITS_DIR/omnemo-one-bar.timer" "$MIMEAPPS" "$ICON_UPDATER" "$SHELL_TOML"
  local shim entry
  for shim in "${ICON_SHIMS[@]}"; do printf '%s\n' "$ICONS_DIR/$shim/index.theme"; done
  for entry in "${FRIENDLY_NAMES[@]}"; do printf '%s\n' "$APPS_DIR/${entry%%|*}.desktop"; done
}

# Copy each managed file into the backup (keeping its full path), or list it
# as absent so uninstall removes it.
backup_managed() {   # "$1" = backup dir
  local f
  : >"$1/absent.list"
  while IFS= read -r f; do
    if [[ -e $f ]]; then mkdir -p "$1/files$(dirname "$f")"; cp -p "$f" "$1/files$f"
    else printf '%s\n' "$f" >>"$1/absent.list"; fi
  done < <(managed_files)
}

restore_managed() {   # "$1" = backup dir
  local f
  while IFS= read -r f; do
    if [[ -e "$1/files$f" ]]; then mkdir -p "$(dirname "$f")"; cp -p "$1/files$f" "$f"
    elif grep -qxF -e "$f" "$1/absent.list"; then rm -f -- "$f"; fi
  done < <(managed_files)
  local shim
  for shim in "${ICON_SHIMS[@]}"; do rmdir "$ICONS_DIR/$shim" 2>/dev/null || true; done
}

# Rename apps whose desktop names mean nothing to a non-developer. The copy in
# ~/.local/share/applications wins over the system one; an Omarchy migration
# can copy foot.desktop back over it, which `status` spots and `repair` fixes.
apply_friendly_names() {
  local entry id name comment src target tmp saved
  mkdir -p "$APPS_DIR"
  for entry in "${FRIENDLY_NAMES[@]}"; do
    IFS='|' read -r id name comment <<<"$entry"
    target="$APPS_DIR/$id.desktop"
    grep -qxF -e "$NAME_MARK" "$target" 2>/dev/null && continue
    src=""
    for src in "$target" "/usr/share/omarchy/applications/$id.desktop" "/usr/share/applications/$id.desktop"; do
      [[ -f $src ]] && break
      src=""
    done
    [[ -n $src ]] || continue   # app not installed
    tmp="$(mktemp)"
    awk -v name="$name" -v comment="$comment" '
      /^\[/ { main = ($0 == "[Desktop Entry]") }
      main && /^Name=/ && !n { print "Name=" name; n = 1; next }
      main && /^Comment=/ && !c { print "Comment=" comment; c = 1; next }
      { print }' "$src" >"$tmp"
    printf '%s\n' "$NAME_MARK" >>"$tmp"
    # An unmarked copy in ~/.local/share/applications may hold the user's own
    # edits; keep it before we replace it.
    if [[ $src == "$target" ]] &&
       ! cmp -s "$target" "/usr/share/omarchy/applications/$id.desktop" &&
       ! cmp -s "$target" "/usr/share/applications/$id.desktop"; then
      saved="$OUR_STATE/replaced/$(date -u +%Y%m%dT%H%M%SZ)"
      mkdir -p "$saved" && cp -p "$target" "$saved/" && say "kept your old $id.desktop in $saved"
    fi
    put "$tmp" "$target"
  done
  update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
}

missing_friendly_names() {
  local entry id
  for entry in "${FRIENDLY_NAMES[@]}"; do
    id="${entry%%|*}"
    [[ -f "/usr/share/applications/$id.desktop" || -f "/usr/share/omarchy/applications/$id.desktop" ]] || continue
    grep -qxF -e "$NAME_MARK" "$APPS_DIR/$id.desktop" 2>/dev/null || printf '%s\n' "$id"
  done
}

install_extras() {
  local shim
  for shim in "${ICON_SHIMS[@]}"; do
    [[ -d "/usr/share/icons/$shim" || -e "$ICONS_DIR/$shim/index.theme" ]] && continue
    mkdir -p "$ICONS_DIR/$shim"
    printf '[Icon Theme]\nName=%s\nComment=Omnemo OS stand-in: an Omarchy theme names this icon set, which is not installed\nInherits=Yaru,hicolor\nDirectories=\n' "$shim" >"$ICONS_DIR/$shim/index.theme"
  done
  apply_friendly_names
  command -v xdg-mime >/dev/null && [[ -f "$APPS_DIR/omawrite.desktop" || -f /usr/share/applications/omawrite.desktop ]] &&
    xdg-mime default omawrite.desktop text/plain
  install -Dm755 "$SYSTEM_SRC/omnemo-one-bar" "$GUARD"
  install -Dm755 "$SYSTEM_SRC/omnemo-icons-update" "$ICON_UPDATER"
  install -Dm644 -t "$UNITS_DIR" "$SYSTEM_SRC/omnemo-one-bar.service" "$SYSTEM_SRC/omnemo-one-bar.timer"
  systemctl --user daemon-reload
  systemctl --user enable --now omnemo-one-bar.timer >/dev/null 2>&1 ||
    say "warning: could not start the one-bar guard; 'omnemo-os repair' tries again"
}

remove_extras() {   # "$1" = backup dir
  systemctl --user disable --now omnemo-one-bar.timer >/dev/null 2>&1 || true
  systemctl --user stop omnemo-one-bar.service >/dev/null 2>&1 || true
  restore_managed "$1"
  systemctl --user daemon-reload
  update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
}

# A restart can leave a second bar behind on a box whose shell runtime folder
# filled up; the guard settles it at once instead of within 30 seconds.
restart_shell() {
  # Omarchy refuses a shell restart while the screen is locked (a long first
  # download can outlast the idle lock); everything else is applied, so note it.
  omarchy restart shell || say "the bar did not restart (screen locked?); unlock, then run: omarchy restart shell"
  [[ -x "$GUARD" ]] && "$GUARD" || true
}

# --- colored icons (MANIFEST §3a) ---------------------------------------------
# The bar's colored icons are the Papirus set (GPL-3.0), downloaded at install,
# not shipped: only the 48x48 folder, into our own folder (never an icon theme,
# so nothing else on the computer changes). Install takes the reviewed release
# below and checks it against its checksum. If the download fails the bar keeps
# its one-color icons; status says so and repair tries again.
ICONS_TAG="20260801"
ICONS_SHA256="646f622e9e7e9e65eef9d0ab58999d4920ddb33d98e6a75232627cfe3bd508f9"
OUR_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/omnemo-os"
ICON_STORE="$OUR_DATA/icons"

icons_install() {   # prints "installed" or "failed"; never dies
  say "icons: downloading the colored icons (about 33 MB)" >&2
  if "$ICON_UPDATER" --pin "$ICONS_TAG" "$ICONS_SHA256" >&2; then echo installed
  else say "icons: not downloaded (no internet?); the bar uses its one-color icons. Run 'omnemo-os repair' later." >&2; echo failed; fi
}

# --- the omnemo-os command (MANIFEST §4) ----------------------------------------
# install copies the edition (this script, plugins, system files, layout) into
# ~/.local/share/omnemo-os/app and links ~/.local/bin/omnemo-os to it, so
# status, repair and uninstall work from any terminal, even after the download
# folder is gone.
APP_DIR="$OUR_DATA/app"
CMD_LINK="$HOME/.local/bin/omnemo-os"

app_install() {
  if [[ "$(readlink -f "$REPO_DIR")" != "$(readlink -f "$APP_DIR" 2>/dev/null)" ]]; then
    rm -rf -- "${APP_DIR:?}.new"
    mkdir -p "$APP_DIR.new"
    cp -r "$REPO_DIR/bin" "$REPO_DIR/plugins" "$REPO_DIR/system" "$REPO_DIR/wallpapers" "$LAYOUT_JSON" "$APP_DIR.new/"
    rm -rf -- "${APP_DIR:?}"; mv "$APP_DIR.new" "$APP_DIR"
  fi
  mkdir -p "$(dirname "$CMD_LINK")"
  ln -sfn "$APP_DIR/bin/omnemo-os" "$CMD_LINK"
}
# --- wallpaper choice (MANIFEST §3b) --------------------------------------------
# Our picture is offered in every theme's wallpaper list (Omarchy reads
# ~/.config/omarchy/backgrounds/<theme>/ and follows links) as a link to the
# installed copy. The current wallpaper is never changed. A same-named file the
# person already has is left alone. Uninstall removes exactly the links and
# folders the record lists.
WALLPAPER="hwy180-west-golden.jpg"
USER_BG="$CFG/omarchy/backgrounds"
wallpaper_themes() {
  local d
  for d in /usr/share/omarchy/themes/*/ "$CFG/omarchy/themes"/*/; do [[ -d $d ]] && basename "$d"; done | sort -u
}
wallpaper_link() {   # prints JSON {links:[], dirs:[]}
  local t dir links=() dirs=()
  while IFS= read -r t; do
    dir="$USER_BG/$t"
    [[ -e $dir/$WALLPAPER || -L $dir/$WALLPAPER ]] && continue
    [[ -d $dir ]] || { mkdir -p "$dir"; dirs+=("$dir"); }
    ln -s "$APP_DIR/wallpapers/$WALLPAPER" "$dir/$WALLPAPER" && links+=("$dir/$WALLPAPER")
  done < <(wallpaper_themes)
  jq -n --args '$ARGS.positional' -- "${links[@]}" | jq --argjson d "$(jq -n --args '$ARGS.positional' -- "${dirs[@]}")" '{links:., dirs:$d}'
}
wallpaper_unlink() {   # "$1" = record
  local l d
  while IFS= read -r l; do
    [[ -n $l && -L $l && "$(readlink "$l")" == "$APP_DIR/wallpapers/$WALLPAPER" ]] && rm -f -- "$l"
  done < <(jq -r '.wallpaper.links[]?' "$1")
  while IFS= read -r d; do [[ -n $d ]] && rmdir "$d" 2>/dev/null || true; done < <(jq -r '.wallpaper.dirs[]?' "$1")
  rmdir "$USER_BG" 2>/dev/null || true
}

cmd_link_ok() { [[ -L $CMD_LINK && "$(readlink "$CMD_LINK")" == "$APP_DIR/bin/omnemo-os" && -x $APP_DIR/bin/omnemo-os ]]; }

# --- Omnemo memory (MANIFEST §4a) --------------------------------------------
# install sets up Omnemo the way its INSTALL.md does (venv + link + `omnemo
# setup`), pinned to a reviewed commit. A box that already has the Omnemo
# program is left alone. uninstall removes the program only if we installed it
# (by record) and never touches the memory store.
OMNEMO_REF="335633defdf04c21e74ebf8350a4fb419037ae51"   # omnemo main, reviewed 2026-10-31
OMNEMO_URL="git+https://github.com/GuyMannDude/omnemo"
OMNEMO_VENV="${XDG_DATA_HOME:-$HOME/.local/share}/omnemo-venv"
OMNEMO_LINK="$HOME/.local/bin/omnemo"
OMNEMO_STORE="${XDG_DATA_HOME:-$HOME/.local/share}/omnemo"

omnemo_program_present() { [[ -e $OMNEMO_VENV || -e $OMNEMO_LINK || -L $OMNEMO_LINK ]]; }
omnemo_bin() { if [[ -x $OMNEMO_VENV/bin/omnemo ]]; then printf '%s\n' "$OMNEMO_VENV/bin/omnemo"; else command -v omnemo; fi; }

# Install the program; prints "installed" or "failed". Never dies: the desktop
# install goes on without memory, status says so, repair tries again.
omnemo_install() {
  {
    command -v python3 >/dev/null && command -v git >/dev/null || { say "memory: python3 and git are needed to install it" >&2; echo failed; return; }
    say "memory: installing Omnemo (downloads a few hundred MB the first time; this can take several minutes)" >&2
    python3 -m venv "$OMNEMO_VENV" >&2 &&
    "$OMNEMO_VENV/bin/pip" install --quiet --disable-pip-version-check "$OMNEMO_URL@$OMNEMO_REF" >&2 &&
    mkdir -p "$(dirname "$OMNEMO_LINK")" && ln -sfn "$OMNEMO_VENV/bin/omnemo" "$OMNEMO_LINK" &&
    "$OMNEMO_VENV/bin/omnemo" --version >&2
  } && {
    # setup rows that cannot be done (a harness that is not installed) are not
    # failures; a FAIL row is shown and kept, the rest still work.
    "$OMNEMO_VENV/bin/omnemo" setup >&2 || say "memory: setup reported a problem above; 'omnemo-os repair' runs it again" >&2
    echo installed
  } || { say "memory: could not install Omnemo (no internet?); the desktop still installs. Run 'omnemo-os repair' later." >&2; echo failed; }
}

# Remove the program we installed. Memories (the store) are never touched.
omnemo_remove() {
  if [[ -x $OMNEMO_VENV/bin/omnemo ]]; then
    "$OMNEMO_VENV/bin/omnemo" disconnect --all-pieces >/dev/null 2>&1 ||
      say "memory: some AI helpers could not be unregistered; see 'omnemo disconnect' output if one complains"
  fi
  [[ -L $OMNEMO_LINK && $(readlink "$OMNEMO_LINK") == "$OMNEMO_VENV/bin/omnemo" ]] && rm -f -- "$OMNEMO_LINK"
  rm -rf -- "${OMNEMO_VENV:?}"
  say "memory: Omnemo program removed"
}

omnemo_memory_count() {   # active memories, or empty when unknown
  local b; b="$(omnemo_bin)" || return 0
  timeout 20 "$b" stats --json 2>/dev/null | jq -r '(.memory_count // 0) - (.superseded // 0)' 2>/dev/null || true
}

omnemo_keep_note() {
  [[ -d $OMNEMO_STORE ]] || return 0
  say "Your memories stay in $OMNEMO_STORE. To delete them yourself: copy the folder somewhere safe, then delete it."
}

# Keep or start fresh (CC #5730). Default is always keep: Enter keeps, no
# terminal to ask in keeps, anything but the typed word DELETE keeps. Deleting
# saves a copy first (~/omnemo-memories-<date>.tar.gz) and checks it.
# "$1" = question; returns 0 when the memories were deleted.
omnemo_offer_fresh() {
  local q="$1" n ans copy
  [[ -d $OMNEMO_STORE ]] || return 1
  if [[ ! -t 0 ]]; then say "memory: no terminal to ask in; keeping your memories in $OMNEMO_STORE"; return 1; fi
  n="$(omnemo_memory_count)"; [[ -n $n ]] || n="your"
  [[ $n == 0 ]] && return 1   # nothing to keep or delete; do not ask
  read -r -p "omnemo-os: ${q/N/$n} [Y/n] " ans || ans=""
  [[ $ans == [nN]* ]] || { say "memory: keeping them"; return 1; }
  read -r -p "omnemo-os: Delete $n memories in $OMNEMO_STORE? A copy is saved first. Type DELETE to confirm: " ans || ans=""
  [[ $ans == DELETE ]] || { say "memory: not DELETE, so keeping them"; return 1; }
  copy="$HOME/omnemo-memories-$(date +%Y-%m-%d).tar.gz"
  [[ -e $copy ]] && copy="$HOME/omnemo-memories-$(date +%Y-%m-%d-%H%M%S).tar.gz"
  tar -czf "$copy" -C "$(dirname "$OMNEMO_STORE")" "$(basename "$OMNEMO_STORE")" && tar -tzf "$copy" >/dev/null ||
    { rm -f -- "$copy"; say "memory: could not save a copy, so nothing was deleted"; return 1; }
  rm -rf -- "${OMNEMO_STORE:?}"
  say "memory: deleted. A copy of the old memories is in $copy"
  return 0
}

# --- install ----------------------------------------------------------------
cmd_install() {
  local allow_rc=0
  [[ "${1:-}" == "--allow-rc" ]] && allow_rc=1
  need omarchy; need jq
  [[ -r "$LAYOUT_JSON" ]] || die "missing $LAYOUT_JSON"
  [[ -f "$SHELL_JSON" ]]  || die "no $SHELL_JSON; is this an Omarchy box?"
  [[ -f "$RECORD" ]] && die "already installed ($RECORD exists); run 'omnemo-os uninstall' first"
  check_version "$allow_rc"

  # All refusals BEFORE any change: never leave a half-applied edition.
  local p
  for p in "${PLUGINS[@]}"; do
    [[ -d "$PLUGIN_SRC/$p" ]] || die "plugin source missing: $PLUGIN_SRC/$p"
    [[ -e "$PLUGIN_DST/$p" ]] && die "$PLUGIN_DST/$p already exists and is not ours; refusing (exact-stock promise)"
  done

  local f
  for f in omnemo-one-bar omnemo-one-bar.service omnemo-one-bar.timer; do
    [[ -f "$SYSTEM_SRC/$f" ]] || die "missing $SYSTEM_SRC/$f"
  done
  [[ -f "$SYSTEM_SRC/omnemo-icons-update" ]] || die "missing $SYSTEM_SRC/omnemo-icons-update"
  [[ -f "$REPO_DIR/wallpapers/$WALLPAPER" ]] || die "missing $REPO_DIR/wallpapers/$WALLPAPER"
  # One rule for every guard file: if any is already there, it is not ours.
  for f in "$GUARD" "$UNITS_DIR/omnemo-one-bar.service" "$UNITS_DIR/omnemo-one-bar.timer" "$ICON_UPDATER" "$CMD_LINK" "$APP_DIR"; do
    [[ -e $f || -L $f ]] && die "$f already exists and is not ours; refusing (exact-stock promise)"
  done

  local ts; ts="$(date -u +%Y%m%dT%H%M%SZ)"
  local bk="$OUR_STATE/backup/$ts"; mkdir -p "$bk" "$PLUGIN_DST"
  cp -p "$SHELL_JSON" "$bk/shell.json"
  # `layout default floating` also pins each busy workspace to its current mode
  # in this directory, so the whole directory is backed up and restored.
  local ws_was="absent"
  if [[ -d "$WS_DIR" ]]; then cp -a "$WS_DIR" "$bk/workspace-layouts"; ws_was="present"; fi
  local hypr_was="absent"
  if [[ -f "$HYPR_LUA" ]]; then
    grep -qxF -e "$RULE_BEGIN" "$HYPR_LUA" && die "$HYPR_LUA already carries an omnemo-os block; refusing"
    cp -p "$HYPR_LUA" "$bk/hyprland.lua"; hypr_was="present"
  fi
  local rule; rule="$(windowrule_block)"   # computed BEFORE any change so a failure here changes nothing
  local menu_was="absent" bind_was="absent" look_was="absent"
  if [[ -f "$MENU_JSONC" ]]; then
    grep -qxF -e "  $MENU_BEGIN" "$MENU_JSONC" && die "$MENU_JSONC already carries an omnemo-os block; refusing"
    grep -qE '^[[:space:]]*"apps"[[:space:]]*:' "$MENU_JSONC" && die "$MENU_JSONC already defines \"apps\" and it is not ours; refusing"
    cp -p "$MENU_JSONC" "$bk/omarchy-menu.jsonc"; menu_was="present"
  fi
  if [[ -f "$BIND_LUA" ]]; then
    grep -qxF -e "$RULE_BEGIN" "$BIND_LUA" && die "$BIND_LUA already carries an omnemo-os block; refusing"
    cp -p "$BIND_LUA" "$bk/bindings.lua"; bind_was="present"
  fi
  if [[ -f "$LOOK_LUA" ]]; then
    grep -qxF -e "$RULE_BEGIN" "$LOOK_LUA" && die "$LOOK_LUA already carries an omnemo-os block; refusing"
    cp -p "$LOOK_LUA" "$bk/looknfeel.lua"; look_was="present"
  fi
  backup_managed "$bk"
  say "backed up to $bk"
  # Record the install before changing anything, so a run that dies partway
  # can still be undone with 'omnemo-os uninstall'.
  jq -n --arg ts "$ts" --arg bk "$bk" --arg ws "$ws_was" --arg hy "$hypr_was" --arg v "$VERSION" \
     --arg me "$menu_was" --arg bi "$bind_was" --arg lo "$look_was" \
     --arg sha "$(sha256sum "$bk/shell.json" | cut -d' ' -f1)" \
     --argjson plugins "$(printf '%s\n' "${PLUGINS[@]}" | jq -R . | jq -s .)" \
     '{installed_at:$ts, edition_version:$v, backup_dir:$bk, shell_json_sha256:$sha, workspace_layouts_was:$ws, hyprland_lua_was:$hy, menu_jsonc_was:$me, bindings_lua_was:$bi, looknfeel_lua_was:$lo, extras:true, plugins:$plugins}' \
     >"$RECORD"

  # Memory first: `omnemo setup` drops its own bar plugin in, and the layout
  # written below then keeps it off the bar (it stays installed, disabled).
  local tmp om_was om_state store_was="absent"
  [[ -e $OMNEMO_STORE/store.db ]] && store_was="present"
  if omnemo_program_present; then
    om_was="present"; om_state="untouched"
    say "memory: Omnemo is already on this computer; leaving it exactly as it is"
  else
    om_was="absent"; om_state="$(omnemo_install)"
    if [[ $store_was == present && $om_state == installed ]]; then
      if omnemo_offer_fresh "Found N memories from before. Keep them?"; then
        store_was="deleted"
        "$OMNEMO_VENV/bin/omnemo" setup >/dev/null 2>&1 || say "memory: setup reported a problem; 'omnemo-os repair' runs it again"
      fi
    fi
  fi
  tmp="$(mktemp)"
  jq --arg w "$om_was" --arg s "$om_state" --arg st "$store_was" --arg ref "$OMNEMO_REF" \
     '. + {omnemo_was:$w, omnemo:$s, omnemo_store_was:$st, omnemo_ref:$ref}' "$RECORD" >"$tmp" && mv "$tmp" "$RECORD"

  for p in "${PLUGINS[@]}"; do cp -r "$PLUGIN_SRC/$p" "$PLUGIN_DST/$p"; done
  say "plugins installed: ${PLUGINS[*]}"

  # MANIFEST §2. Commands first (they may rewrite shell.json), layout last.
  shell_step omarchy bar position bottom
  shell_step omarchy bar background opaque   # MANIFEST §2: 'opaque' keeps the text white; shell.toml below makes it clear for guy.flag
  shell_step omarchy plugin disable omarchy.dock   # MANIFEST §2: stock dock off; .dock.pinned stays for guy.favorites
  shell_step omarchy hyprland workspace layout default floating
  tmp="$(mktemp)"
  jq --slurpfile L "$LAYOUT_JSON" '.bar.layout = $L[0]' "$SHELL_JSON" >"$tmp" && put "$tmp" "$SHELL_JSON"
  say "bar layout written"

  mkdir -p "$(dirname "$HYPR_LUA")"
  [[ -f "$HYPR_LUA" ]] || : >"$HYPR_LUA"
  printf '\n%s\n' "$rule" >>"$HYPR_LUA"
  say "windowrule written to $HYPR_LUA"

  mkdir -p "$(dirname "$MENU_JSONC")"
  if [[ ! -f "$MENU_JSONC" ]]; then
    if [[ -f "$MENU_SEED" ]]; then cp -p "$MENU_SEED" "$MENU_JSONC"; else printf '{\n}\n' >"$MENU_JSONC"; fi
  fi
  menu_insert "$MENU_JSONC"
  omarchy-menu refresh >/dev/null 2>&1 || true
  [[ -f "$BIND_LUA" ]] || : >"$BIND_LUA"
  printf '\n%s\n' "$(bindings_block)" >>"$BIND_LUA"
  [[ -f "$LOOK_LUA" ]] || : >"$LOOK_LUA"
  printf '\n%s\n' "$(looknfeel_block)" >>"$LOOK_LUA"
  hyprctl reload >/dev/null 2>&1 || true
  say "Apps menu entry, Super+Alt+Space and cursor rule written"
  # MANIFEST §2: the flag bar (clear bar over guy.flag, navy menus, azure accents).
  # shell.toml
  # is in managed_files, so uninstall puts it back byte-exact (or removes it).
  if grep -qF "omnemo-os:begin" "$SHELL_TOML" 2>/dev/null; then
    say "bar colours: $SHELL_TOML already carries an omnemo-os block; leaving it"
  else
    mkdir -p "$(dirname "$SHELL_TOML")"
    { [[ -s $SHELL_TOML ]] && printf '\n'; cat "$SYSTEM_SRC/omnemo-look-flag.toml"; } >>"$SHELL_TOML"
    say "bar colours written to $SHELL_TOML"
  fi

  install_extras
  say "one-bar guard on; friendly app names, icon sets and Writer for text files set"

  local icons_was="absent" icons_state="untouched"
  if [[ -f $ICON_STORE/VERSION ]]; then icons_was="present"; say "icons: colored icons already here (Papirus $(cat "$ICON_STORE/VERSION")); keeping them"
  else icons_state="$(icons_install)"; fi
  app_install
  tmp="$(mktemp)"
  jq --arg w "$icons_was" --arg s "$icons_state" --arg t "$ICONS_TAG" \
     '. + {icons_was:$w, icons:$s, icons_tag:$t, command_link:true}' "$RECORD" >"$tmp" && mv "$tmp" "$RECORD"
  local wp; wp="$(wallpaper_link)"
  tmp="$(mktemp)"; jq --argjson w "$wp" '. + {wallpaper:$w}' "$RECORD" >"$tmp" && mv "$tmp" "$RECORD"
  say "wallpaper: Hwy 180 at golden hour added to every theme's wallpaper choices (Tools > Theme & wallpaper)"
  say "the omnemo-os command is ready in any new terminal: omnemo-os status | repair | uninstall"

  restart_shell
  case "$om_state" in
    installed) say "memory: on. Start a NEW session of your AI helper (claude, codex, ...) and it shares one memory." ;;
    failed)    say "memory: NOT installed yet; run 'omnemo-os repair' when you are online" ;;
  esac
  say "installed. Undo: omnemo-os uninstall"
}

# --- uninstall --------------------------------------------------------------
cmd_uninstall() {
  need omarchy; need jq
  [[ -f "$RECORD" ]] || die "not installed (no $RECORD)"
  local bk ws_was hypr_was; bk="$(jq -r .backup_dir "$RECORD")"; ws_was="$(jq -r '.workspace_layouts_was // .default_lua_was' "$RECORD")"; hypr_was="$(jq -r '.hyprland_lua_was // "absent"' "$RECORD")"
  local menu_was bind_was look_was
  menu_was="$(jq -r '.menu_jsonc_was // "untouched"' "$RECORD")"; bind_was="$(jq -r '.bindings_lua_was // "untouched"' "$RECORD")"; look_was="$(jq -r '.looknfeel_lua_was // "untouched"' "$RECORD")"
  [[ -f "$bk/shell.json" ]] || die "backup missing: $bk/shell.json; refusing to guess"
  local want have; want="$(jq -r .shell_json_sha256 "$RECORD")"; have="$(sha256sum "$bk/shell.json" | cut -d' ' -f1)"
  [[ "$want" == "$have" ]] || die "backup checksum mismatch; refusing to restore a tampered file"

  # Memory first, while its own uninstaller is still there. Only what we
  # installed (by record); the memories themselves always stay.
  local fresh=0
  case "$(jq -r '.omnemo // "untouched"' "$RECORD")" in
    installed|failed)
      omnemo_offer_fresh "Keep your memories?" && fresh=1
      omnemo_remove ;;
  esac

  cp -p "$bk/shell.json" "$SHELL_JSON"   # also re-enables omarchy.dock: disabledPlugins lives in shell.json
  case "$ws_was" in
    present) [[ -d "$bk/workspace-layouts" ]] || die "backup missing: $bk/workspace-layouts; refusing to guess"
             rm -rf "${WS_DIR:?}"; cp -a "$bk/workspace-layouts" "$WS_DIR" ;;
    absent)  rm -rf "${WS_DIR:?}" ;;
  esac
  case "$hypr_was" in
    present) cp -p "$bk/hyprland.lua" "$HYPR_LUA" ;;          # byte-exact stock user file
    absent)  [[ -f "$HYPR_LUA" ]] && { windowrule_remove "$HYPR_LUA"; [[ -s "$HYPR_LUA" ]] || rm -f "$HYPR_LUA"; } ;;
  esac
  # "untouched" = installed by a version that did not write these files.
  case "$menu_was" in
    present) cp -p "$bk/omarchy-menu.jsonc" "$MENU_JSONC" ;;
    absent)  [[ -f "$MENU_JSONC" ]] && { menu_remove "$MENU_JSONC"; rm -f "$MENU_JSONC"; } ;;
  esac
  [[ "$menu_was" != untouched ]] && { omarchy-menu refresh >/dev/null 2>&1 || true; }
  case "$bind_was" in
    present) cp -p "$bk/bindings.lua" "$BIND_LUA" ;;
    absent)  [[ -f "$BIND_LUA" ]] && { windowrule_remove "$BIND_LUA"; [[ -s "$BIND_LUA" ]] || rm -f "$BIND_LUA"; } ;;
  esac
  case "$look_was" in
    present) cp -p "$bk/looknfeel.lua" "$LOOK_LUA" ;;
    absent)  [[ -f "$LOOK_LUA" ]] && { windowrule_remove "$LOOK_LUA"; [[ -s "$LOOK_LUA" ]] || rm -f "$LOOK_LUA"; } ;;
  esac
  [[ "$(jq -r '.extras // false' "$RECORD")" == true ]] && remove_extras "$bk"
  hyprctl reload >/dev/null 2>&1 || true   # also re-reads the restored workspace layouts
  local p
  while IFS= read -r p; do
    [[ -n "$p" && -d "$PLUGIN_DST/$p" ]] && rm -rf "${PLUGIN_DST:?}/$p"
  done < <(jq -r '.plugins[]' "$RECORD")
  # Icons only if we downloaded them (by record).
  [[ "$(jq -r '.icons // "untouched"' "$RECORD")" =~ ^(installed|failed)$ ]] && rm -rf -- "${ICON_STORE:?}" "$ICON_STORE.new" "$ICON_STORE.old"
  wallpaper_unlink "$RECORD"
  local cmd_link; cmd_link="$(jq -r '.command_link // false' "$RECORD")"
  mv "$RECORD" "$OUR_STATE/uninstalled-$(date -u +%Y%m%dT%H%M%SZ).json"
  omarchy restart shell || say "the bar did not restart (screen locked?); unlock, then run: omarchy restart shell"
  "$REPO_DIR/system/omnemo-one-bar" 2>/dev/null || true   # the installed guard is gone now
  say "restored to stock (shell.json byte-exact from $bk)"
  (( fresh )) || omnemo_keep_note
  # Last of all: this script may be running from the copy it removes (bash
  # keeps reading the open file, so that is safe).
  if [[ $cmd_link == true ]]; then
    [[ -L $CMD_LINK && "$(readlink "$CMD_LINK")" == "$APP_DIR/bin/omnemo-os" ]] && rm -f -- "$CMD_LINK"
    rm -rf -- "${APP_DIR:?}"
    rmdir "$OUR_DATA" 2>/dev/null || true
  fi
}

cmd_status() {
  if [[ -f "$RECORD" ]]; then say "installed:"; jq . "$RECORD"; else say "not installed"; fi
  local v; v="$(omarchy_version 2>/dev/null)" || v=unknown; say "omarchy: $v"
  local n
  if omnemo_program_present && [[ -n $(omnemo_bin) ]]; then
    n="$(omnemo_memory_count)"
    if [[ -f "$RECORD" && "$(jq -r '.omnemo_was // ""' "$RECORD")" == present ]]; then
      say "memory: on (already installed before Omnemo OS; uninstall leaves it alone)${n:+, $n saved}"
    else say "memory: on${n:+, $n saved}"; fi
    say "memory: uninstall asks before touching your memories in $OMNEMO_STORE (Enter keeps them)"
  else
    if [[ -f "$RECORD" && "$(jq -r '.omnemo // ""' "$RECORD")" != untouched ]]; then say "memory: OFF -- run 'omnemo-os repair'"; else say "memory: off"; fi
  fi
  if [[ -f "$RECORD" ]]; then
    local lost; lost="$(missing_friendly_names | tr '\n' ' ')"
    [[ -n $lost ]] && say "an Omarchy update reset the friendly names of: $lost-- run 'omnemo-os repair'"
    systemctl --user is-active --quiet omnemo-one-bar.timer || say "the one-bar guard is off -- run 'omnemo-os repair'"
    if [[ -f $ICON_STORE/VERSION ]]; then say "icons: colored (Papirus $(cat "$ICON_STORE/VERSION"))"
    else say "icons: one-color only; the colored icons are missing -- run 'omnemo-os repair'"; fi
    [[ "$(jq -r '.command_link // false' "$RECORD")" != true ]] || cmd_link_ok || say "the omnemo-os command link is broken -- run 'omnemo-os repair'"
  fi
  return 0
}

# Put back what an Omarchy update may have reset, without touching the backup.
cmd_repair() {
  [[ -f "$RECORD" ]] || die "not installed (no $RECORD)"
  if [[ "$(jq -r '.omnemo // "untouched"' "$RECORD")" == failed ]] || { [[ "$(jq -r '.omnemo // ""' "$RECORD")" == installed ]] && ! omnemo_program_present; }; then
    local st tmp; st="$(omnemo_install)"
    tmp="$(mktemp)"; jq --arg s "$st" '.omnemo = $s' "$RECORD" >"$tmp" && mv "$tmp" "$RECORD"
    [[ $st == installed ]] || die "memory: still could not install Omnemo (no internet?)"
  elif [[ "$(jq -r '.omnemo // ""' "$RECORD")" == installed ]]; then
    "$OMNEMO_VENV/bin/omnemo" setup >/dev/null 2>&1 || say "memory: 'omnemo setup' reported a problem; run it by hand to see which"
  fi
  apply_friendly_names
  [[ -x $ICON_UPDATER ]] || install -Dm755 "$SYSTEM_SRC/omnemo-icons-update" "$ICON_UPDATER"
  if [[ ! -f $ICON_STORE/VERSION ]]; then
    local ist tmp2; ist="$(icons_install)"
    # Ours from now on unless they were here before Omnemo OS.
    [[ "$(jq -r '.icons_was // "absent"' "$RECORD")" == present ]] ||
      { tmp2="$(mktemp)"; jq --arg s "$ist" '.icons = $s' "$RECORD" >"$tmp2" && mv "$tmp2" "$RECORD"; }
    [[ $ist == installed ]] && restart_shell
  fi
  [[ "$(jq -r '.command_link // false' "$RECORD")" != true ]] || cmd_link_ok || app_install
  [[ -f "$UNITS_DIR/omnemo-one-bar.timer" && -x "$GUARD" ]] || {
    install -Dm755 "$SYSTEM_SRC/omnemo-one-bar" "$GUARD"
    install -Dm644 -t "$UNITS_DIR" "$SYSTEM_SRC/omnemo-one-bar.service" "$SYSTEM_SRC/omnemo-one-bar.timer"
    systemctl --user daemon-reload
  }
  systemctl --user enable --now omnemo-one-bar.timer >/dev/null 2>&1 || true
  local lost; lost="$(missing_friendly_names | tr '\n' ' ')"
  [[ -z $lost ]] || die "could not restore the friendly names of: $lost"
  systemctl --user is-active --quiet omnemo-one-bar.timer || die "the one-bar guard would not start (systemctl --user status omnemo-one-bar.timer)"
  say "friendly names, the one-bar guard, colored icons and the omnemo-os command are back"
}

sub="${1:-}"; case "$(basename "$0")" in omnemo-os-install) sub=install; set -- "$@" ;; omnemo-os-uninstall) sub=uninstall ;; esac
case "$sub" in
  install)   [[ "${1:-}" == install ]] && shift; cmd_install "$@" ;;
  uninstall) cmd_uninstall ;;
  status)    cmd_status ;;
  repair)    cmd_repair ;;
  *) printf 'usage: omnemo-os install [--allow-rc] | uninstall | status | repair\n'; exit 2 ;;
esac
